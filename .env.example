# Gateway del sito completo (scripts/avvia.mjs + gateway/server.js). Nessun segreto qui:
# le chiavi Supabase stanno nei .env delle singole app (vedi apps/*/.env.example).
#
# Porta pubblica del sito (landing, /prenota, /dashboard, /test-server)
PORT=3000
# Porte interne delle app, usate solo da scripts/avvia.mjs (sovrascrivono il PORT dei loro .env)
DASHBOARD_API_PORT=3101
PRENOTA_PORT=3102
TEST_SERVER_PORT=3103
DASHBOARD_VITE_PORT=5180
