# Stringa di connessione Postgres del progetto Supabase "recupera"
# (Dashboard Supabase > Connect > Session pooler). Mai committare il valore reale.
DATABASE_URL=postgresql://postgres.jjkxvbjwruobclgwhtdt:<password>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# Segreto per firmare i token degli admin: genera con `openssl rand -hex 32`
JWT_SECRET=

PORT=3001

# Frontend di Prenota su /prenota e login admin: URL del progetto e chiave anon (pubblica, Supabase > API Keys)
SUPABASE_URL=https://jjkxvbjwruobclgwhtdt.supabase.co
SUPABASE_ANON_KEY=

# Login admin, stesso account della dashboard (recupera-dashboard/backend/.env):
# username atteso qui, password verificata da Supabase Auth sull'email qui sotto (ruolo admin in app_metadata).
ADMIN_USER=admin
ADMIN_EMAIL=
