# Supabase Configuration
SUPABASE_URL=https://jjkxvbjwruobclgwhtdt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:5173

# Auth admin singolo via Supabase Auth (cfr. backend/src/auth.js).
# La UI invia {username, password}: username atteso qui, password verificata
# da Supabase sull'email qui sotto. Il ruolo admin vive in app_metadata
# (solo service_role può scriverlo). Niente password in DB applicativo
# (public.admin_users resta solo per recupera-test-server, la dashboard non la usa).
ADMIN_USER=admin
ADMIN_EMAIL=admin@recupera.local
# Usata SOLO da `npm run create:admin` per impostare la password (mai letta a runtime).
ADMIN_PASSWORD=
